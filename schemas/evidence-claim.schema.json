{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiterx0910/agent-creativity-frontier/schemas/evidence-claim.schema.json",
  "title": "FrontierOS evidence claim",
  "description": "Claim-level provenance for a quantitative or qualitative research statement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_text",
    "status",
    "source",
    "evidence",
    "scope",
    "verified_at"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["verified", "partially_verified", "unverified", "disputed", "retracted"]
    },
    "observation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "treatment_value": {"type": ["number", "null"]},
        "baseline_value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "absolute_effect": {"type": ["number", "null"]},
        "relative_effect_percent": {"type": ["number", "null"]},
        "confidence_interval": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["level", "lower", "upper"],
          "properties": {
            "level": {"type": "number", "minimum": 0, "maximum": 1},
            "lower": {"type": "number"},
            "upper": {"type": "number"}
          }
        },
        "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "effect_is_reported_or_derived": {
          "type": "string",
          "enum": ["reported", "derived", "not_applicable"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "publication_status", "version", "locator"],
      "properties": {
        "title": {"type": "string"},
        "authors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "url": {"type": "string", "format": "uri"},
        "venue": {"type": ["string", "null"]},
        "publication_status": {
          "type": "string",
          "enum": ["peer_reviewed", "accepted", "preprint", "official_document", "other"]
        },
        "version": {"type": "string"},
        "locator": {
          "type": "string",
          "description": "Table, figure, page, section or line locator."
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_type", "tasks", "models"],
      "properties": {
        "evaluation_type": {
          "type": "string",
          "enum": ["human_blind_review", "expert_review", "randomized_trial", "llm_judge", "automatic_metric", "real_world_outcome", "mixed"]
        },
        "sample_size": {"type": ["integer", "null"], "minimum": 0},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "models": {
          "type": "array",
          "items": {"type": "string"}
        },
        "languages": {
          "type": "array",
          "items": {"type": "string"}
        },
        "human_population": {
          "type": ["string", "null"]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "does_not_support": {
          "type": "array",
          "items": {"type": "string"}
        },
        "transfer_risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "unknown"]
        }
      }
    },
    "engineering_decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "action": {"type": "string"},
        "default_or_experiment": {"type": "string", "enum": ["default", "experiment", "reject", "watch"]},
        "reproduction_required": {"type": "boolean"}
      }
    },
    "verified_by": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "verified_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
